  individual_net_buy_qty decimal(24,0) [null, note: '개인 순매수 수량']
  individual_net_buy_value_million decimal(24,0) [null, note: '개인 순매수 금액; 백만 단위']
  institution_net_buy_qty decimal(24,0) [null, note: '기관 순매수 수량']
  institution_net_buy_value_million decimal(24,0) [null, note: '기관 순매수 금액; 백만 단위']
  securities_net_buy_qty decimal(24,0) [null, note: '증권 순매수 수량']
  securities_net_buy_value_million decimal(24,0) [null, note: '증권 순매수 금액; 백만 단위']
