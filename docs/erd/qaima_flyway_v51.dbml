  indexes {
    (market_code, industry_code, trade_date, source) [unique, name: 'uk_market_investor_flow_market_industry_date_source']
    (market_code, trade_date) [name: 'idx_market_investor_flow_market_date']
    trade_date [name: 'idx_market_investor_flow_trade_date']
