  short_volume_total decimal(24,6) [null, note: '공매도 총거래량']
  short_volume_uptick_applied decimal(24,6) [null, note: '업틱룰 적용 공매도 거래량']
  short_volume_uptick_exempt decimal(24,6) [null, note: '업틱룰 예외 공매도 거래량']
  total_volume decimal(24,6) [null, note: '전체 거래량']
  short_volume_ratio decimal(10,6) [null, note: '공매도 거래량 비율']
  short_amount_total decimal(20,0) [null, note: '공매도 총거래대금']
  short_amount_uptick_applied decimal(20,0) [null, note: '업틱룰 적용 공매도 거래대금']
  short_amount_uptick_exempt decimal(20,0) [null, note: '업틱룰 예외 공매도 거래대금']
  total_amount decimal(20,0) [null, note: '전체 거래대금']
  short_amount_ratio decimal(10,6) [null, note: '공매도 거래대금 비율']
  source varchar(50) [not null, default: 'KRX', note: '데이터 출처']
  source_screen_id varchar(20) [not null, default: 'MDCSTAT301', note: '원천 조회 화면 ID']
  created_at datetime(6) [not null, note: '생성 시각']
  updated_at datetime(6) [not null, note: '최종 수정 시각']

  indexes {
    (stock_id, report_date) [unique, name: 'uk_short_selling_stock_date']
    report_date [name: 'idx_short_selling_report_date']
    (market_code, report_date) [name: 'idx_short_selling_market_date']
  }
}

// 스키마 정의/변경: V29
Table stock_investor_flow [note: '종목·거래일·출처별 투자자 유형별 순매수 수량/금액'] {
