////////////////////////////////////////////////////////////
// QAIMA ERD — dbdiagram.io용 DBML
// 기준: backend/src/main/resources/db/migration/V1__*.sql ~ V51__*.sql
// 작성일: 2026-09-30
// 51개 Flyway 파일을 버전 순서로 합친 최종 스키마:
//   47개 테이블 / 570개 컬럼 / 41개 FK / SQL ENUM 2종
//
// 사용: 이 파일 전체를 dbdiagram.io에 붙여넣거나 DBML로 가져오기.
// 아래 설명은 읽기용이며, 스키마의 원본은 Flyway SQL이다.
//
// 반영 기준
// - CREATE TABLE 이후 ADD/MODIFY COLUMN 및 추가 인덱스를 누적 반영.
// - V37 조건부 동적 DDL도 새 DB에 V1~V51을 순서 적용한 결과로 반영.
// - V39/V40 임시 seed 테이블은 종료 시 삭제되므로 ERD에서 제외.
// - 데이터 INSERT/UPDATE의 행 내용과 Flyway 이력 테이블은 표시하지 않음.
// - PK, UNIQUE, 명시된 인덱스 이름, NULL, DB 기본값, FK 동작을 반영.
// - FK 지원용으로 MySQL이 자동 생성하는 인덱스는 별도 기재하지 않음.
// - 관계선은 SQL에 선언된 FK만 표시. 이름이 비슷한 컬럼 간 관계를 추정하지 않음.
// - 기본값이 없는 시각/상태 컬럼에는 now()/false 등의 기본값을 추가하지 않음.
// - CURRENT_TIMESTAMP는 문자열이 아닌 DBML의 백틱 표현식으로 표기.
// - JSON처럼 이름 붙은 VARCHAR 컬럼은 실제 VARCHAR 타입 그대로 유지.
//
// MySQL 표현 주의
// - news.url(255), news_sentiment_observation.title(191)은 접두 인덱스.
//   DBML에는 구성 컬럼을 표시하고 실제 접두 길이는 index note에 명시.
//   SQL로 변환하면 접두 길이가 보존되지 않으므로 실행 DDL은 Flyway를 사용할 것.
// - ENGINE/CHARSET 및 DB 실행 환경 설정은 Flyway SQL을 참조.
// - NULL 허용은 [null]로, SQL에 없는 DEFAULT는 생략해서 표현.
// - portfolio.user_id 및 stock_realtime_cache.stock_id의 유일성은 1:1 관계로 표시.
//
// 주요 버전 변경
// - V23 비밀번호 NULL 허용 / V33 가입 전 이메일 인증.
// - V34 credit_balance 기본값 5 / V35 공매도 거래량 DECIMAL(24,6).
// - V36~V41 SEC 매핑·발행주식·13F 및 집계 인덱스.
// - V42~V47 위험계수·포트폴리오·리포트·사용자 프로필 확장.
// - V48~V50 영문 용어 설명 추가·TINYTEXT 확정·데이터 채움.
// - V51 login_session.user_agent VARCHAR(512), api_request_log.query_string TEXT.
////////////////////////////////////////////////////////////

Project QAIMA_Flyway_V51 {
  database_type: 'MySQL'
  Note: 'Flyway V1~V51 최종 스키마. 47 tables / 570 columns / 41 foreign keys. 원본: backend/src/main/resources/db/migration. 접두 인덱스는 시각화용 표현이므로 실행 DDL은 Flyway를 사용한다.'
}

////////////////////////////////////////////////////////////
// DB에 실제 선언된 Enum
////////////////////////////////////////////////////////////

Enum users_role_enum {
  user
  admin
}

Enum indicator_value_freq_enum {
  one_min
  five_min
  fifteen_min
  one_h
  one_d
  one_w
  one_m
}


////////////////////////////////////////////////////////////
// 종목 기준정보 (Reference)
////////////////////////////////////////////////////////////

// 스키마 정의/변경: V1
Table exchange [note: '거래소 마스터'] {
  exchange_id bigint [pk, not null, increment, note: '거래소 ID']
  code varchar(20) [not null, note: '코드']
  name varchar(100) [not null, note: '거래소명']
  timezone varchar(50) [null, note: '거래소 기준 타임존']
  country varchar(2) [null, note: '거래소 국가 코드']

  indexes {
    code [unique, name: 'uk_exchange_code']
  }
}

// 스키마 정의/변경: V1
Table sector [note: '거래소·분류 체계별 섹터 마스터'] {
  sector_id bigint [pk, not null, increment, note: '섹터 ID']
  exchange_id bigint [not null, note: '거래소 ID']
  scheme varchar(30) [not null, note: '분류 체계 코드']
  code varchar(50) [not null, note: '코드']
  name varchar(100) [not null, note: '섹터명']

  indexes {
    (exchange_id, scheme, code) [unique, name: 'uk_sector_exchange_scheme_code']
    exchange_id [name: 'idx_sector_exchange_id']
    name [name: 'idx_sector_name']
  }
}

// 스키마 정의/변경: V1
Table industry [note: '거래소·섹터·분류 체계별 산업 마스터'] {
  industry_id bigint [pk, not null, increment, note: '산업 ID']
  exchange_id bigint [not null, note: '거래소 ID']
  sector_id bigint [not null, note: '섹터 ID']
  scheme varchar(30) [not null, note: '분류 체계 코드']
  code varchar(50) [not null, note: '코드']
  name varchar(100) [not null, note: '산업명']

  indexes {
    (exchange_id, sector_id, scheme, code) [unique, name: 'uk_industry_exchange_sector_scheme_code']
    exchange_id [name: 'idx_industry_exchange_id']
    name [name: 'idx_industry_name']
    sector_id [name: 'idx_industry_sector_id']
  }
}

// 스키마 정의/변경: V1, V15, V17, V36, V37
Table stock [note: '종목 기본 정보 및 DART·SEC 기업 식별자/동기화 시각'] {
  stock_id bigint [pk, not null, increment, note: '종목 ID']
  exchange_id bigint [not null, note: '거래소 ID']
  stock_code varchar(32) [not null, note: '종목 코드/티커']
  isin varchar(20) [null, note: '국제증권식별번호']
  company_name varchar(255) [not null, note: '회사명/종목명']
  sector_id bigint [null, note: '섹터 ID']
  industry_id bigint [null, note: '산업 ID']
  asset_type varchar(20) [null, note: '자산 유형']
  currency varchar(3) [default: 'KRW', null, note: '통화']
  share_class varchar(20) [not null, default: 'OTHER', note: '주식 종류']
  dart_corp_code varchar(8) [null, note: 'DART 기업 고유번호']
  dart_corp_name varchar(255) [null, note: 'DART 기업명']
  dart_modified_date date [null, note: 'DART 기업정보 수정일']
  dart_synced_at datetime(6) [null, note: 'DART 기업정보 동기화 시각']
  sec_cik varchar(10) [null, note: 'SEC 기업 식별번호 CIK']
  sec_company_name varchar(255) [null, note: 'SEC 기업명']
  sec_synced_at datetime(6) [null, note: 'SEC 기업정보 동기화 시각']
  sec_issued_shares_synced_at datetime(6) [null, note: 'SEC 발행주식 동기화 시각']
  listed_at date [null, note: '상장일']
  delisted_at date [null, note: '상장폐지일']

  indexes {
    (exchange_id, stock_code) [unique, name: 'uk_exchange_stock_code']
    exchange_id [name: 'idx_stock_exchange_id']
    sector_id [name: 'idx_stock_sector_id']
    industry_id [name: 'idx_stock_industry_id']
    dart_corp_code [name: 'idx_stock_dart_corp_code']
    dart_modified_date [name: 'idx_stock_dart_modified_date']
    share_class [name: 'idx_stock_share_class']
    sec_cik [name: 'idx_stock_sec_cik']
    sec_synced_at [name: 'idx_stock_sec_synced_at']
    sec_issued_shares_synced_at [name: 'idx_stock_sec_issued_shares_synced_at']
  }
}

// 스키마 정의/변경: V9
Table stock_alias [note: '종목 검색용 별칭과 정규화 별칭'] {
  alias_id bigint [pk, not null, increment, note: '레코드 고유 ID']
  stock_id bigint [not null, note: '종목 ID']
  alias_name varchar(255) [not null, note: '종목 별칭']
  normalized_alias varchar(255) [not null, note: '정규화된 종목 별칭']
  created_at datetime(6) [not null, note: '생성 시각']

  indexes {
    (stock_id, normalized_alias) [unique, name: 'uk_stock_alias_stock_norm']
    normalized_alias [name: 'idx_stock_alias_norm']
    stock_id [name: 'idx_stock_alias_stock']
  }
}

// 스키마 정의/변경: V38
Table stock_security_identifier [note: 'CUSIP 등 외부 증권 식별자와 종목 매핑'] {
  stock_security_identifier_id bigint [pk, not null, increment, note: '레코드 고유 ID']
  stock_id bigint [not null, note: '종목 ID']
  identifier_type varchar(20) [not null, note: '외부 식별자 유형']
  identifier_value varchar(32) [not null, note: '외부 식별자 값']
  issuer_name varchar(255) [null, note: '발행사명']
  source varchar(50) [not null, note: '데이터 출처']
  confidence int [not null, default: 100, note: '매핑 신뢰도']
  active boolean [not null, default: true, note: '활성 여부']
  created_at datetime(6) [not null, note: '생성 시각']
  updated_at datetime(6) [not null, note: '최종 수정 시각']

  indexes {
    (stock_id, identifier_type, identifier_value) [unique, name: 'uk_stock_security_identifier_stock_type_value']
    (identifier_type, identifier_value) [name: 'idx_stock_security_identifier_type_value']
    stock_id [name: 'idx_stock_security_identifier_stock']
  }
}


////////////////////////////////////////////////////////////
// 시세·기술지표·시장 스냅샷 (Market_Data)
////////////////////////////////////////////////////////////

// 스키마 정의/변경: V5
Table price_ohlcv [note: '종목별 시계열 OHLCV. freq는 SQL ENUM이 아닌 TINYINT'] {
  stock_id bigint [not null, note: '종목 ID']
  ts datetime(6) [not null, note: '데이터 기준 시각']
  freq tinyint [not null, note: '주기 코드; 실제 DB 타입은 TINYINT']
  open decimal(18,6) [null, note: '시가']
  high decimal(18,6) [null, note: '고가']
  low decimal(18,6) [null, note: '저가']
  close decimal(18,6) [null, note: '종가']
  volume decimal(20,0) [null, note: '거래량']

  indexes {
    (stock_id, ts, freq) [pk]
  }
}

// 스키마 정의/변경: V5
Table indicator_value [note: '기술지표 값 캐시. id PK와 종목·시각·주기·지표 키 UNIQUE 사용'] {
  id bigint [pk, not null, increment, note: '레코드 고유 ID']
  stock_id bigint [not null, note: '종목 ID']
  ts datetime(6) [not null, note: '데이터 기준 시각']
  freq indicator_value_freq_enum [not null, note: '기술지표 주기; DB에 선언된 7개 ENUM 값']
  indicator_key varchar(50) [not null, note: '기술지표 키']
  value_num decimal(20,8) [null, note: '단일 수치형 지표 값']
  value_json varchar(255) [null, note: '지표 복합 값 문자열; 실제 타입 VARCHAR(255)']

  indexes {
    (stock_id, ts, freq, indicator_key) [unique, name: 'uq_indicator_unique']
  }
}

// 스키마 정의/변경: V5
Table stock_realtime_cache [note: '종목별 최신 시세 캐시. stock_id PK로 종목당 최대 1행'] {
  stock_id bigint [pk, not null, note: '종목 ID']
  ts datetime(6) [not null, note: '데이터 기준 시각']
  prev_close decimal(18,6) [null, note: '전일 종가']
  last decimal(18,6) [null, note: '최신 가격']
  change_ratio decimal(10,6) [null, note: '등락 비율']
  volume decimal(20,0) [null, note: '거래량']
  turnover decimal(20,6) [null, note: '거래대금']
}

// 스키마 정의/변경: V10, V16, V18, V19
Table market_snapshot [note: '종목·기준일별 시가총액·재무비율·배치 산출값 스냅샷'] {
  snapshot_id bigint [pk, not null, increment, note: '레코드 고유 ID']
  stock_id bigint [not null, note: '종목 ID']
  as_of_date date [not null, note: '스냅샷 기준일']
  market_cap decimal(20,0) [null, note: '시가총액']
  float_market_cap decimal(20,0) [null, note: '유통주식 기준 시가총액']
  per decimal(10,4) [null, note: '주가수익비율']
  pbr decimal(10,4) [null, note: '주가순자산비율']
  float_ratio decimal(10,4) [null, note: '유통주식 비율']
  treasury_ratio decimal(10,4) [null, note: '자기주식 비율']
  shares_outstanding decimal(20,0) [null, note: '발행주식 수']
  eps_ttm decimal(20,6) [null, note: '최근 12개월 주당순이익']
  bps decimal(20,6) [null, note: '주당순자산']
  sps decimal(20,6) [null, note: '주당매출액']
  roe decimal(10,4) [null, note: '자기자본이익률']
  roa decimal(10,4) [null, note: '총자산이익률']
  operating_margin decimal(10,4) [null, note: '영업이익률']
  net_margin decimal(10,4) [null, note: '순이익률']
  debt_ratio decimal(10,4) [null, note: '부채비율']
  current_assets decimal(20,2) [null, note: '유동자산']
  current_liabilities decimal(20,2) [null, note: '유동부채']
  inventory decimal(20,2) [null, note: '재고자산']
  interest_expense decimal(20,2) [null, note: '이자비용']
  operating_cash_flow decimal(20,2) [null, note: '영업활동 현금흐름']
  capex decimal(20,2) [null, note: '자본적 지출']
  warning_flags varchar(255) [null, note: '산출/데이터 경고 플래그']
  source varchar(50) [null, note: '데이터 출처']
  created_at datetime(6) [not null, note: '생성 시각']

  indexes {
    (stock_id, as_of_date) [unique, name: 'uk_market_snapshot_stock_date']
    (stock_id, as_of_date) [name: 'idx_market_snapshot_stock_date']
  }
}

// 스키마 정의/변경: V20
Table market_holiday [note: '시장별 휴장일. V20에서 테이블 생성 및 2026년 KRX 휴장일 seed'] {
  id bigint [pk, not null, increment, note: '휴장일 PK; 원본 DDL의 CONSTRAINT pk_market_holiday']
  market varchar(20) [not null, note: '시장 구분']
  holiday_date date [not null, note: '휴장일']
  name varchar(100) [not null, note: '휴장일명']
  source varchar(100) [not null, note: '데이터 출처']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '생성 시각']

  indexes {
    (market, holiday_date) [unique, name: 'uq_market_holiday']
    (market, holiday_date) [name: 'idx_market_holiday_market_date']
  }
}


////////////////////////////////////////////////////////////
// 재무·발행주식·공매도·투자자 수급 (Financials_and_Flows)
////////////////////////////////////////////////////////////

// 스키마 정의/변경: V5
Table financial [note: '재무 데이터. 종목·회계연도·기간 유형·기간 번호 UNIQUE; version은 PK에 포함되지 않음'] {
  financial_id bigint [pk, not null, increment, note: '레코드 고유 ID']
  stock_id bigint [not null, note: '종목 ID']
  report_date date [not null, note: '보고 기준일']
  version int [not null, note: '재무 데이터 버전']
  fiscal_year int [not null, note: '회계연도']
  period_no int [not null, note: '기간 번호; 재무 데이터 UNIQUE 구성 컬럼']
  fiscal_quarter int [null, note: '회계분기']
  period_type varchar(10) [not null, note: '재무 기간 유형; VARCHAR 저장']
  filing_date date [null, note: '공시/제출일']
  currency varchar(10) [null, note: '통화']
  source varchar(50) [null, note: '데이터 출처']
  revenue decimal(20,2) [null, note: '매출액']
  gross_profit decimal(20,2) [null, note: '매출총이익']
  operating_income decimal(20,2) [null, note: '영업이익']
  net_income decimal(20,2) [null, note: '당기순이익']
  assets decimal(20,2) [null, note: '자산총계']
  current_assets decimal(20,2) [null, note: '유동자산']
  liabilities decimal(20,2) [null, note: '부채총계']
  current_liabilities decimal(20,2) [null, note: '유동부채']
  equity decimal(20,2) [null, note: '자본총계']
  capital_stock decimal(20,2) [null, note: '자본금']
  retained_earnings decimal(20,2) [null, note: '이익잉여금']
  cash_and_equivalents decimal(20,2) [null, note: '현금 및 현금성 자산']
  accounts_receivable decimal(20,2) [null, note: '매출채권']
  inventories decimal(20,2) [null, note: '재고자산']
  short_term_borrowings decimal(20,2) [null, note: '단기차입금']
  current_portion_of_long_term_borrowings decimal(20,2) [null, note: '유동성 장기차입금']
  long_term_borrowings decimal(20,2) [null, note: '장기차입금']
  operating_cash_flow decimal(20,2) [null, note: '영업활동 현금흐름']
  investing_cash_flow decimal(20,2) [null, note: '투자활동 현금흐름']
  financing_cash_flow decimal(20,2) [null, note: '재무활동 현금흐름']
  interest_expense decimal(20,2) [null, note: '이자비용']
  capex_ppe decimal(20,2) [null, note: '유형자산 취득 지출']
  capex_intangible decimal(20,2) [null, note: '무형자산 취득 지출']
  depreciation_expense decimal(20,2) [null, note: '감가상각비']
  amortization_expense decimal(20,2) [null, note: '무형자산상각비']
  income_tax_expense decimal(20,2) [null, note: '법인세비용']
  market_cap decimal(20,2) [null, note: '시가총액']
  operating_margin decimal(10,4) [null, note: '영업이익률']
  net_margin decimal(10,4) [null, note: '순이익률']
  roe decimal(10,4) [null, note: '자기자본이익률']
  per decimal(10,4) [null, note: '주가수익비율']
  pbr decimal(10,4) [null, note: '주가순자산비율']
  created_at datetime(6) [not null, note: '생성 시각']
  updated_at datetime(6) [not null, note: '최종 수정 시각']

  indexes {
    (stock_id, fiscal_year, period_type, period_no) [unique, name: 'uk_financial_stock_period']
    (stock_id, period_type, fiscal_year, period_no) [name: 'idx_financials_stock_fiscal_period']
  }
}

// 스키마 정의/변경: V14, V37
Table issued_shares [note: 'DART·SEC 발행주식 및 자기주식·유통주식 데이터'] {
  issued_shares_id bigint [pk, not null, increment, note: '레코드 고유 ID']
  stock_id bigint [not null, note: '종목 ID']
  rcept_no varchar(32) [not null, note: '공시 접수번호; SEC 지원으로 VARCHAR(32)']
  corp_cls varchar(10) [null, note: '기업 구분']
  corp_code varchar(10) [not null, note: '공시 기업 코드']
  corp_name varchar(255) [null, note: '기업명']
  share_type varchar(50) [not null, note: '주식 종류']
  authorized_shares bigint [null, note: '발행할 주식 총수']
  issued_shares_to_date bigint [null, note: '누적 발행주식 수']
  decreased_shares_to_date bigint [null, note: '누적 감소주식 수']
  decreased_by_reduction bigint [null, note: '감자로 감소한 주식 수']
  decreased_by_profit_incineration bigint [null, note: '이익소각으로 감소한 주식 수']
  decreased_by_redemption bigint [null, note: '상환으로 감소한 주식 수']
  decreased_by_other bigint [null, note: '기타 사유로 감소한 주식 수']
  issued_shares_total bigint [null, note: '발행주식 총수']
  treasury_shares bigint [null, note: '자기주식 수']
  floating_shares bigint [null, note: '유통주식 수']
  base_date date [not null, note: '기준일']
  source varchar(50) [not null, default: 'OPENDART', note: '데이터 출처']
  created_at datetime(6) [not null, note: '생성 시각']
  updated_at datetime(6) [not null, note: '최종 수정 시각']

  indexes {
    (stock_id, base_date, share_type) [unique, name: 'uk_issued_shares_stock_date_type']
    (stock_id, base_date) [name: 'idx_issued_shares_stock_date']
    (corp_code, base_date) [name: 'idx_issued_shares_corp_code_date']
  }
}

// 스키마 정의/변경: V11, V35
Table short_selling [note: '종목·보고일별 공매도 거래량/거래대금. V35에서 거래량 소수 정밀도 확장'] {
  short_selling_id bigint [pk, not null, increment, note: '레코드 고유 ID']
