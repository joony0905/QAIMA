  investment_trust_net_buy_value_million decimal(24,0) [null, note: '투신 순매수 금액; 백만 단위']
  private_fund_net_buy_qty decimal(24,0) [null, note: '사모펀드 순매수 수량']
  private_fund_net_buy_value_million decimal(24,0) [null, note: '사모펀드 순매수 금액; 백만 단위']
  bank_net_buy_qty decimal(24,0) [null, note: '은행 순매수 수량']
  bank_net_buy_value_million decimal(24,0) [null, note: '은행 순매수 금액; 백만 단위']
  insurance_net_buy_qty decimal(24,0) [null, note: '보험 순매수 수량']
  insurance_net_buy_value_million decimal(24,0) [null, note: '보험 순매수 금액; 백만 단위']
  fund_net_buy_qty decimal(24,0) [null, note: '기금 순매수 수량']
  fund_net_buy_value_million decimal(24,0) [null, note: '기금 순매수 금액; 백만 단위']
  other_net_buy_qty decimal(24,0) [null, note: '기타 순매수 수량']
  other_net_buy_value_million decimal(24,0) [null, note: '기타 순매수 금액; 백만 단위']
  source varchar(50) [not null, default: 'KIS', note: '데이터 출처']
  source_tr_id varchar(20) [not null, default: 'FHPTJ04160001', note: '원천 거래/API ID']
  created_at datetime(6) [not null, note: '생성 시각']
  updated_at datetime(6) [not null, note: '최종 수정 시각']

  indexes {
